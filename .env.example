# --- ECS Local Console: server configuration ---
# The AWS-compatible endpoint to talk to. LocalStack / MiniStack / Moto all default to 4566.
# Leave unset to talk to real AWS (uses the default credential chain).
AWS_ENDPOINT_URL=http://localhost:4566

# Region and credentials. LocalStack and MiniStack accept the dummy "test" / "test" pair.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Optional: use a named profile from ~/.aws/credentials instead of the keys above.
# AWS_PROFILE=

# Port the backend listens on (it also serves the built web UI in production).
PORT=4570

# Comma-separated extra CORS origins for the API in dev. The Vite dev server proxies
# /api itself, so this is only needed if you run the web app on a non-proxied origin.
# WEB_ORIGIN=http://localhost:8080
