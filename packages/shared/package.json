    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "eslint": "^9.32.0",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
